{
  "permissions": {
    "allow": [
      "Bash(npx tsc *)",
      "WebSearch",
      "WebFetch(domain:apereo.github.io)",
      "WebFetch(domain:github.com)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(echo \"---EXIT: $?\")",
      "Bash(git reflog *)",
      "Bash(git gc *)",
      "Bash(git stash *)",
      "Bash(python3 -c \"import sys,json; d=json.load\\(sys.stdin\\); print\\(json.dumps\\({k:v for k,v in d.get\\('scripts',{}\\).items\\(\\)}, indent=2\\)\\)\")",
      "Bash(git update-ref *)",
      "Bash(python3 -c ' *)",
      "Bash(node -e ' *)",
      "Bash(npx vitest *)",
      "Bash(python3 *)",
      "Bash(node *)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code 需要您的确认操作\" with title \"🤖 Claude 提示\"'"
          }
        ]
      }
    ]
  }
}
