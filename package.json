{
  "name": "hdcpu",
  "version": "1.0.0",
  "description": "RISC-V CPU Simulator with Multi-Cycle Visualization",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "build": "npm run typecheck && vite build",
    "dev": "vite",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "deploy:check": "node scripts/verify-dist.mjs",
    "verify": "npm run lint && npm run test:run && npm run build && npm run deploy:check"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@uiw/react-codemirror": "^4.25.9",
    "framer-motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zustand": "^5.0.12"
  }
}
